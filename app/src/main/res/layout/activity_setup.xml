<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="@string/setup_title"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- 1. enabled in Settings? -->
        <TextView
            android:id="@+id/status_enabled"
            style="@style/Emkeys.Status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/action_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_open_ime_settings" />

        <!-- 2. the current IME? -->
        <TextView
            android:id="@+id/status_current"
            style="@style/Emkeys.Status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/action_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_pick_ime" />

        <!-- 3. hard keyboard suppression -->
        <TextView
            android:id="@+id/status_hard_keyboard"
            style="@style/Emkeys.Status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/adb_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@color/ink_raise"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:textColor="@color/muted"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/swap_fn_ctrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/swap_fn_ctrl"
            android:textColor="@color/text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:text="@string/keyboard_help"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:text="@string/smoke_test_label"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/smoke_test"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:autofillHints=""
            android:background="@color/ink_raise"
            android:fontFamily="monospace"
            android:gravity="top|start"
            android:hint="@string/smoke_test_hint"
            android:imeOptions="flagNoExtractUi"
            android:inputType="textMultiLine"
            android:padding="10dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
